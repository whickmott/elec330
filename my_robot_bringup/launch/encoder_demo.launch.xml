<launch>
  <arg name="motors" default="false"/>
  <let name="model" value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"/>
  <let name="controllers" value="$(find-pkg-share my_robot_bringup)/config/encoder_controllers.yaml"/>

  <let name="sim_time" value="true"/>
  <let name="states" value="/sim/joint_state_broadcaster/joint_states"/>
  <group if="$(var motors)">
    <let name="unused" value="unused"/>
  </group>
  <let name="sim_time" value="false" if="$(var motors)"/>
  <let name="states" value="/joint_state_broadcaster/joint_states" if="$(var motors)"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher" output="screen">
    <param name="robot_description" type="str"
           value="$(command 'xacro $(var model) gazebo:=true motors:=$(var motors)')"/>
    <param name="use_sim_time" value="$(var sim_time)"/>
    <remap from="joint_states" to="$(var states)"/>
  </node>

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher" namespace="/sim" output="screen">
    <param name="robot_description" type="str"
           value="$(command 'xacro $(var model) gazebo:=true motors:=false')"/>
    <param name="use_sim_time" value="true"/>
    <remap from="joint_states" to="/sim/joint_state_broadcaster/joint_states"/>
    <remap from="/tf" to="/sim/tf"/>
    <remap from="/tf_static" to="/sim/tf_static"/>
  </node>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="empty.sdf -r"/>
  </include>

  <node pkg="ros_gz_sim" exec="create" output="screen"
        args="-topic /sim/robot_description -name my_robot -z 0.05"/>

  <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
    <param name="config_file"
           value="$(find-pkg-share my_robot_bringup)/config/encoder_clock_bridge.yaml"/>
  </node>

  <node pkg="controller_manager" exec="spawner" output="screen"
        args="joint_state_broadcaster wheel_position_controller -c /sim/controller_manager --controller-manager-timeout 120"/>

  <group if="$(var motors)">
    <node pkg="controller_manager" exec="ros2_control_node" output="screen">
      <param from="$(var controllers)"/>
      <param name="update_rate" value="20"/>
      <remap from="robot_description" to="/robot_description"/>
    </node>
    <node pkg="controller_manager" exec="spawner" output="screen"
          args="joint_state_broadcaster motor_controller -c /controller_manager --controller-manager-timeout 30"/>
  </group>

  <node pkg="my_robot_bringup" exec="encoder_wheels.py" output="screen">
    <param name="from_joint_states" value="$(var motors)"/>
    <param name="radians_per_count" value="0.1"/>
  </node>

  <node pkg="rviz2" exec="rviz2" output="screen"
        args="-d $(find-pkg-share my_robot_description)/rviz/urdf_config.rviz">
    <param name="use_sim_time" value="$(var sim_time)"/>
  </node>
</launch>