<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.6" />
  <xacro:property name="base_width" value="0.4" />
  <xacro:property name="base_height" value="0.2" />
  <xacro:property name="wheel_radius" value="0.1" />
  <xacro:property name="wheel_length" value="0.05" />
  <xacro:property name="caster_radius" value="${wheel_radius/2}" />

  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" />
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" />
      <geometry><box size="${base_length} ${base_width} ${base_height}" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" />
      <geometry><box size="${base_length} ${base_width} ${base_height}" /></geometry>
    </collision>
    <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}" o_xyz="0 0 ${base_height/2}" o_rpy="0 0 0" />
  </link>

  <xacro:macro name="wheel_link" params="prefix">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_length}" /></geometry>
        <material name="grey" />
      </visual>
      <visual>
        <geometry><box size="${wheel_radius*0.12} ${wheel_length+0.004} ${wheel_radius*1.6}" /></geometry>
        <material name="blue" />
      </visual>
      <collision>
        <geometry><sphere radius="${wheel_radius}" /></geometry>
      </collision>
      <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" l="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0" />
    </link>
  </xacro:macro>

  <xacro:wheel_link prefix="left" />
  <xacro:wheel_link prefix="right" />

  <joint name="base_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="${base_length/4} ${base_width/2+wheel_length/2} 0" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="base_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="${base_length/4} ${-base_width/2-wheel_length/2} 0" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="${caster_radius}" /></geometry>
      <material name="grey" />
    </visual>
    <collision><geometry><sphere radius="${caster_radius}" /></geometry></collision>
    <xacro:sphere_inertia m="0.5" r="${caster_radius}" o_xyz="0 0 0" o_rpy="0 0 0" />
  </link>
  <joint name="base_caster_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster_wheel_link" />
    <origin xyz="${-base_length/3} 0 ${caster_radius-wheel_radius}" />
  </joint>
<link name="front_marker_link"><visual>
      <origin xyz="0 0 0" />
      <geometry><box size="0.01 0.12 0.06" /></geometry>
      <material name="front_marker"><color rgba="1 0.3 0 1" /></material>
    </visual>
    </link><joint name="front_marker_joint" type="fixed"><parent link="base_link" /><child link="front_marker_link" /><origin xyz="${base_length/2} 0 ${base_height/2}" /></joint></robot>